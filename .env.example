# Copia este archivo como .env.local para desarrollo. Nunca subas .env reales al repositorio.

# "demo"  -> los registros NO se envían ni se guardan (modo actual, obligatorio hasta completar requisitos legales).
# "live"  -> los registros se envían al backend (se habilitará en la FASE 3, previa autorización).
VITE_REGISTRATION_MODE=demo

# URL pública del sitio. Cambiarla aquí es todo lo necesario para pasar a sorteo.rincel.com.mx.
VITE_SITE_URL=https://sorteo-rincel.pages.dev

# Clave PÚBLICA (site key) de Cloudflare Turnstile. La clave secreta va solo en Cloudflare como secreto.
VITE_TURNSTILE_SITE_KEY=
